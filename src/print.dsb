.include src/aliases.dsb

.section print

// Print a null-terminated string to derial
.export derialPrintString
    push     FL
    push     OA
    push     G0
    push     G1
    compi    G0 0
    breqpc   derialPrintStringDone
    move     OA G0
    move     G1 0
:derialPrintStringLoop
    loadcoa  G0 G1
    compi    G0 0
    breqpc   derialPrintStringDone
    bpalpc   derialPrint
    addi     G1 G1 1
    bralpc   derialPrintStringLoop
:derialPrintStringDone
    pop      G1
    pop      G0
    pop      OA
    pop      FL
    return

// Print what is in the G0 register to derial
:derialPrint
    push     FL
    push     OA
    push     G0
    loadwab  OA serialPortDDATAddress
    storcoa  G0 3
:derialPrintWaitForFlush
    // Keep checking the status register for buffer not empty
    loadcoa  G0 6
    and      G0 G0 0b00000001
    brnepc   derialPrintWaitForFlush
    pop      G0
    pop      OA
    pop      FL
    return

.export syscallPrint // 0x40
    storwab  SB callSBStorage
    storhab  SS callSSStorage
    storhab  SP callSPStorage
    move     SB DIOS_SB
    move     SS DIOS_SS
    move     SP 0

    push     FL
    push     G7
    intgpr   G7

    compi    G7 0x00
    bpeqpc   derialPrint

    compi    G7 0x01
    bpeqpc   derialPrintString

    pop      G7
    .requires interruptRestoreAndFinish
    bralpc   interruptRestoreAndFinish
