.include src/aliases.dsb

.section scan

.export scanForDevices
    move     OA 0x5FF8

    // NULL the ddat address variables
    move     G0 0
    storwab  G0 keyboardDDATAddress
    storwab  G0 serialPortDDATAddress
    storwab  G0 driveManagerDDATAddress
    storwab  G0 driveDDATAdress
    storwab  G0 timerDDATAddress

:deviceScanLoopTop
    addi     OA OA 8
    compi    OA 0x6100
    brhspc   doneDeviceScan
    loadcoa  G0 1
    compi    G0 0x02
    breqpc   foundStorageDevice
    compi    G0 0x05
    breqpc   foundPeripheral
    compi    G0 0x04
    breqpc   foundTimer
    compi    G0 0xFF
    breqpc   doneDeviceScan
    bralpc   deviceScanLoopTop

:foundStorageDevice
    loadwoa  OB 4
    loadcob  G0 0
    compi    G0 0x01
    breqpc   foundDardriveManager
    compi    G0 0x02
    breqpc   foundDardriveDrive
    bralpc   deviceScanLoopTop

:foundDardriveManager
    storcab  G0 driveManagerType
    loadwab  G0 driveManagerDDATAddress
    compi    G0 0
    brnepc   deviceScanLoopTop
    storwab  OB driveManagerDDATAddress
    subi     G0 OA 0x6000
    bsrt     G0 G0 3
    storcab  G0 driveManagerDeviceId
    
    bralpc   deviceScanLoopTop

:foundDardriveDrive
    storcab  G0 driveType
    loadwab  G0 driveDDATAdress
    compi    G0 0
    brnepc   deviceScanLoopTop
    storwab  OB driveDDATAdress
    subi     G0 OA 0x6000
    bsrt     G0 G0 3
    storcab  G0 driveDeviceId
    bralpc   deviceScanLoopTop

:foundPeripheral
    loadwoa  OB 4
    loadcob  G0 0
    compi    G0 0x4B
    breqpc   foundKeyboard
    compi    G0 0x53
    breqpc   foundSerialPort
    bralpc   deviceScanLoopTop

:foundKeyboard
    loadwab  G0 keyboardDDATAddress
    compi    G0 0
    brnepc   deviceScanLoopTop
    loadcob  G0 1
    compi    G0 0x01
    breqpc   foundDboard
    bralpc   deviceScanLoopTop

:foundDboard
    storcab  G0 keyboardType
    storwab  OB keyboardDDATAddress
    subi     G0 OA 0x6000
    bsrt     G0 G0 3
    storcab  G0 keyboardDeviceId
    bralpc   deviceScanLoopTop

:foundSerialPort
    loadwab  G0 serialPortDDATAddress
    compi    G0 0
    brnepc   deviceScanLoopTop
    loadcob  G0 1
    compi    G0 0x01
    breqpc   foundDerial
    bralpc   deviceScanLoopTop

:foundDerial
    storcab  G0 serialPortType
    storwab  OB serialPortDDATAddress
    subi     G0 OA 0x6000
    bsrt     G0 G0 3
    storcab  G0 serialPortDeviceId
    bralpc   deviceScanLoopTop

:foundTimer
    loadwoa  OB 4
    loadcob  G0 0
    compi    G0 0x01
    brnepc   deviceScanLoopTop
    // Is dimer
    storcab  G0 timerType
    storwab  OB timerDDATAddress
    subi     G0 OA 0x6000
    bsrt     G0 G0 3
    storcab  G0 timerDeviceId
    bralpc   deviceScanLoopTop

:doneDeviceScan
    return
