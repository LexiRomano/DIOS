.include src/aliases.dsb

.section sleep

.export syscallSleep // 0x42
    storwab  SB callSBStorage
    storwab  SS callSSStorage
    storwab  SP callSPStorage
    move     SB DIOS_SB
    move     SS DIOS_SS
    move     SP 0

    push     G7
    intgpr   G7

    compi    G7 0x00
    bpeqpc   microSleep

    pop      G7
    .requires interruptRestoreAndFinish
    bralpc   interruptRestoreAndFinish



:microSleep
    push     G0
    push     G2
    push     OA

    loadwab  OA timerDDATAddress
    move     G2 0 // Config: no interrupts, one-shot
    storcoa  G2 1

    :microSleepBigSectionLoop
    compi    G0 0xFFFF
    brlspc   microSleepSmallSection
    subi     G0 G0 0xFFFF
    move     G2 0xFFFF
    storhoa  G2 2
    bpalpc   microSleepWait
    bralpc   microSleepBigSectionLoop

    :microSleepSmallSection
    storhoa  G0 2
    bpalpc   microSleepWait

    pop      OA
    pop      G2
    pop      G0
    return

:microSleepWait
    loadhoa  G2 2
    compi    G2 0
    brnepc   microSleepWait
    return
