.include src/aliases.dsb

.section main

.requires derialPrintString

// Initialize stack
    move     SB DIOS_SB
    move     SS DIOS_SS
    move     SP 0

// Initialize variables in RAM
    move     G0 0
    storcab  G0 serialInputBufferHeadPointer
    storcab  G0 serialInputBufferTailPointer
    storcab  G0 keyboardInputBufferHeadPointer
    storcab  G0 keyboardInputBufferTailPointer

// Initialize interrupt table
    move     IL 0x9000
    move     OA IL

    getabs   G0 unhandledInterrupt
    move     G1 0

:fillUnusedSysCallLoopTop
    compi    G1 0x400
    brhspc   doneFillUnusedSysCall
    storwoa  G0 G1
    addi     G1 G1 4
    bralpc   fillUnusedSysCallLoopTop

:doneFillUnusedSysCall
// Initialize hardware interrupts
    .requires   handleKeyPress
    getabs   G0 handleKeyPress
    storwoa  G0 0x04

    .requires   handleKeyRelease
    getabs   G0 handleKeyRelease
    storwoa  G0 0x08

    getabs   G0 peripheralEvent
    storwoa  G0 0x0C

// Initialize used syscalls
    .requires   syscallPrint
    getabs   G0 syscallPrint
    storwoa  G0 0x100

    .requires   syscallCharIn
    getabs   G0 syscallCharIn
    storwoa  G0 0x104

    .requires   syscallSleep
    getabs   G0 syscallSleep
    storwoa  G0 0x108

// Scan for devices
    .requires scanForDevices
    bpalpc   scanForDevices


// Check for a serial port
    loadwab  G0 serialPortDDATAddress
    compi    G0 0
    breqpc   term

// Configure derial
    move     OA G0
    move     G0 0b110 // int on rcv, autoflush, no int on flush complete
    storcoa  G0 5

    getabs   G0 DIOSInitString
    bpalpc   derialPrintString

    loadwab  OA driveDDATAdress
    compi    OA 0
    brnepc   boot
    getabs   G0 noDriveFoundString
    bpalpc   derialPrintString
    bralpc   waitToDie

:boot
    getabs   G0 driveFoundString
    bpalpc   derialPrintString

// Configure drive
    move     G0 0b00000000 // disable interrupts
    storcoa  G0 0xC

    move     G0 BOOT_LOCATION
    storwoa  G0 3
    move     G0 0
    storwoa  G0 7
    storcoa  G0 0xB
:waitForDriveToLoad
    loadcoa  G0 0xD
    and      G1 G0 0b00000001
    brnepc   waitForDriveToLoad
    and      G1 G0 0b00000010
    breqab   BOOT_LOCATION
    getabs   G0 driveLoadFail
    bpalpc   derialPrintString

:waitToDie
    loadwab  OA serialPortDDATAddress

:waitToDieLoop
    loadcoa  G0 6
    and      G0 G0 0b00000100
    breqpc   waitToDieLoop
    loadcoa  G0 2

:term
    // TODO terminate from motherboard
    getabs   G0 tmpKillMe
    bpalpc   derialPrintString
    bralpc   0

:unhandledInterrupt
    intfin

:peripheralEvent
    storwab  SB callSBStorage
    storwab  SS callSSStorage
    storwab  SP callSPStorage
    move     SB DIOS_SB
    move     SS DIOS_SS
    move     SP 0
    push     FL

    push     G7
    intgpr   G7
    and      G7 G7 0b00111111

    compi    G7 serialPortDeviceId
    bpalpc   handleSerialInput

    pop      G7
    bralpc   interruptRestoreAndFinish

:handleSerialInput
    push     G0
    push     G1
    push     OA

    loadwab  OA serialPortDDATAddress
    loadcoa  G0 2

    move     OA serialInputBuffer
    loadcab  G1 serialInputBufferHeadPointer
    storcoa  G0 G1

    addi     G1 G1 1
    compi    G1 SERIAL_INPUT_BUFFER_SIZE
    brlopc   doneHandleSerialInput

    move     G1 0
:doneHandleSerialInput
    storcab  G1 serialInputBufferHeadPointer

    pop      OA
    pop      G1
    pop      G0
    return

.export interruptRestoreAndFinish
    pop      FL
    loadwab  SB callSBStorage
    loadhab  SS callSSStorage
    loadhab  SP callSPStorage
    intfin

:DIOSInitString
    .set * "~DIOS~\r\n\n"

:noDriveFoundString
    .set * "No drive found, press any key to terminate: \r\n"

:driveFoundString
    .set * "Booting from drive...\r\n\n"

:driveLoadFail
    .set * "Failed to boot from drive, press any key to terminate: \r\n"

:tmpKillMe
    .set * "Terminate not supported yet, please close manually\r\n"
