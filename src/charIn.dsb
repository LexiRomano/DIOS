.include src/aliases.dsb

.section charIn
.requires interruptRestoreAndFinish

.export syscallCharIn // 0x41
    storwab  SB callSBStorage
    storhab  SS callSSStorage
    storhab  SP callSPStorage
    move     SB DIOS_SB
    move     SS DIOS_SS
    move     SP 0
    push     FL

    push     G7
    intgpr   G7

    compi    G7 0x00
    bpeqpc   getNextSerialChar

    compi    G7 0x01
    bpeqpc   getNextKeyboardChar

    pop      G7
    bralpc   interruptRestoreAndFinish



:getNextSerialChar
    push     G1

    loadcab  G1 serialInputBufferTailPointer
    loadcab  G0 serialInputBufferHeadPointer

    compi    G0 G1
    move     G0 0
    breqpc   doneGetNextSerialChar

    push     OA
    move     OA serialInputBuffer
    loadcoa  G0 G1

    addi     G1 G1 1
    compi    G1 SERIAL_INPUT_BUFFER_SIZE
    brlopc   getNextSerialCharStoreNewTail
    move     G1 0

:getNextSerialCharStoreNewTail
    storcab  G1 serialInputBufferTailPointer
    pop      OA
:doneGetNextSerialChar
    pop      G1
    return



:getNextKeyboardChar
    push     G1

    loadcab  G1 keyboardInputBufferTailPointer
    loadcab  G0 keyboardInputBufferHeadPointer

    compi    G0 G1
    move     G0 0
    breqpc   doneGetNextKeyboardChar

    push     OA
    move     OA keyboardInputBuffer
    loadcoa  G0 G1

    addi     G1 G1 1
    compi    G1 KEYBOARD_INPUT_BUFFER_SIZE
    brlopc   getNextKeyboardCharStoreNewTail
    move     G1 0

:getNextKeyboardCharStoreNewTail
    storcab  G1 keyboardInputBufferTailPointer
    pop      OA
:doneGetNextKeyboardChar
    pop      G1
    return



.export handleKeyPress
    storwab  SB callSBStorage
    storhab  SS callSSStorage
    storhab  SP callSPStorage
    move     SB DIOS_SB
    move     SS DIOS_SS
    move     SP 0
    push     FL

    push     G0
    intgpr   G0

    // Regular characters
    compi    G0 0x2E // `
    brlspc   regularCharacterPressed
    compi    G0 0x32 // TAB
    breqpc   regularCharacterPressed
    compi    G0 0x37 // BACKSPACE
    breqpc   regularCharacterPressed
    compi    G0 0x39 // SPACE
    breqpc   regularCharacterPressed

    // Special keys
    compi    G0 0x36 // ENTER
    brhspc   specialKeyPressed

    // Modifier keys
    compi    G0 0x35 // RALT
    brlspc   modifierKeyPressed

    // Some unknown key, ignore

    :doneHandleKeyPress
    pop      G0

    bralpc   interruptRestoreAndFinish



:regularCharacterPressed
    compi    G0 0x32 // TAB
    brnepc   notTab
    move     G0 0x09 // Ascii htab
    bpalpc   addToKeyboardBuffer
    bralpc   doneHandleKeyPress

    :notTab
    compi    G0 0x39 // SPACE
    brnepc   notSpace
    move     G0 0x20 // Ascii space
    bpalpc   addToKeyboardBuffer
    bralpc   doneHandleKeyPress

    :notSpace
    compi    G0 0x37 // BACKSPACE
    brnepc   notBackspace
    move     G0 0x08 // Ascii backspace
    bpalpc   addToKeyboardBuffer
    bralpc   doneHandleKeyPress

    :notBackspace
    push     G1
    loadcab  G1 keyboardModifiers
    and      G1 G1 0b00000011 // Isolate shifts
    pop      G1
    brnepc   regCharWithShift

    // No shift
    compi    G0 0x19 // z
    brhipc   notSmallLetter
    addi     G0 G0 0x61 // ascii 'a'
    bpalpc   addToKeyboardBuffer
    bralpc   doneHandleKeyPress

    :notSmallLetter
    compi    G0 0x23 // 9
    brhipc   notNumber
    addi     G0 G0 0x16 // ascii '0' - 0x1A (0)
    bpalpc   addToKeyboardBuffer
    bralpc   doneHandleKeyPress

    :notNumber
    compi    G0 0x2E // `
    brhipc   doneHandleKeyPress
    push     OA
    getabs   OA baseExtraSymbolLookup
    subi     G0 G0 0x24 // -
    loadcoa  G0 G0
    bpalpc   addToKeyboardBuffer
    pop      OA
    bralpc   doneHandleKeyPress

:regCharWithShift
    compi    G0 0x19 // z
    brhipc   notBigLetter
    addi     G0 G0 0x41 // ascii 'A'
    bpalpc   addToKeyboardBuffer
    bralpc   doneHandleKeyPress

    :notBigLetter
    compi    G0 0x23 // 9
    brhipc   notShiftedNumber
    push     OA
    getabs   OA shiftedNumberLookup
    subi     G0 G0 0x1A // 0
    loadcoa  G0 G0
    pop      OA
    bpalpc   addToKeyboardBuffer
    bralpc   doneHandleKeyPress

    :notShiftedNumber
    compi    G0 0x2E // `
    brhipc   doneHandleKeyPress
    push     OA
    getabs   OA shiftedExtraSymbolLookup
    subi     G0 G0 0x24 // -
    loadcoa  G0 G0
    bpalpc   addToKeyboardBuffer
    pop      OA
    bralpc   doneHandleKeyPress



:specialKeyPressed
    bralpc   doneHandleKeyPress



:modifierKeyPressed
    compi    G0 0x2F // LCTRL
    brnepc   notLCtrl
    loadcab  G0 keyboardModifiers
    or       G0 G0 LCTRL_MASK
    storcab  G0 keyboardModifiers
    bralpc   doneHandleKeyPress

    :notLCtrl
    compi    G0 0x33 // RCTRL
    brnepc   notRCtrl
    loadcab  G0 keyboardModifiers
    or       G0 G0 RCTRL_MASK
    storcab  G0 keyboardModifiers
    bralpc   doneHandleKeyPress

    :notRCtrl
    compi    G0 0x30 // LSHIFT
    brnepc   notLShift
    loadcab  G0 keyboardModifiers
    or       G0 G0 LSHIFT_MASK
    storcab  G0 keyboardModifiers
    bralpc   doneHandleKeyPress

    :notLShift
    compi    G0 0x34 // RSHIFT
    brnepc   notRShift
    loadcab  G0 keyboardModifiers
    or       G0 G0 RSHIFT_MASK
    storcab  G0 keyboardModifiers
    bralpc   doneHandleKeyPress

    :notRShift
    compi    G0 0x31 // LALT
    brnepc   notLAlt
    loadcab  G0 keyboardModifiers
    or       G0 G0 LALT_MASK
    storcab  G0 keyboardModifiers
    bralpc   doneHandleKeyPress

    :notLAlt
    compi    G0 0x35 // RALT
    brnepc   doneHandleKeyPress
    loadcab  G0 keyboardModifiers
    or       G0 G0 RALT_MASK
    storcab  G0 keyboardModifiers
    bralpc   doneHandleKeyPress



:addToKeyboardBuffer
    compi    G0 0
    breqpc   noKeyboardAddition

    push     OA
    push     G1

    move     OA keyboardInputBuffer
    loadcab  G1 keyboardInputBufferHeadPointer

    storcoa  G0 G1

    addi     G1 G1 1
    compi    G1 KEYBOARD_INPUT_BUFFER_SIZE
    brlopc   doneKeyboardAddition

    move     G1 0

    :doneKeyboardAddition
    storcab  G1 keyboardInputBufferHeadPointer

    pop      G1
    pop      OA
    :noKeyboardAddition
    return



.export handleKeyRelease
    storwab  SB callSBStorage
    storhab  SS callSSStorage
    storhab  SP callSPStorage
    move     SB DIOS_SB
    move     SS DIOS_SS
    move     SP 0
    push     FL

    push     G0
    intgpr   G0

    bralpc   modifierKeyReleased

    :doneHandleKeyRelease
    pop      G0
    bralpc   interruptRestoreAndFinish




:modifierKeyReleased
    push     G1

    compi    G0 0x2F // LCTRL
    brnepc   notLCtrlRel
    move     G1 LCTRL_MASK
    bralpc   foundModifierToRelease

    :notLCtrlRel
    compi    G0 0x33 // RCTRL
    brnepc   notRCtrlRel
    move     G1 RCTRL_MASK
    bralpc   foundModifierToRelease

    :notRCtrlRel
    compi    G0 0x30 // LSHIFT
    brnepc   notLShiftRel
    move     G1 LSHIFT_MASK
    bralpc   foundModifierToRelease

    :notLShiftRel
    compi    G0 0x34 // RSHIFT
    brnepc   notRShiftRel
    move     G1 RSHIFT_MASK
    bralpc   foundModifierToRelease

    :notRShiftRel
    compi    G0 0x31 // LALT
    brnepc   notLAltRel
    move     G1 LALT_MASK
    bralpc   foundModifierToRelease

    :notLAltRel
    compi    G0 0x35 // RALT
    brnepc   doneHandleModifierKeyRelase
    move     G1 RALT_MASK
    bralpc   foundModifierToRelease

    :foundModifierToRelease
    loadcab  G0 keyboardModifiers
    not      G1 G1
    and      G0 G0 G1
    storcab  G0 keyboardModifiers
    

    :doneHandleModifierKeyRelase
    pop      G1
    bralpc   doneHandleKeyRelease



:shiftedNumberLookup
    .set 1 0x29 // 0 -> )
    .set 1 0x21 // 1 -> !
    .set 1 0x40 // 2 -> @
    .set 1 0x23 // 3 -> #
    .set 1 0x24 // 4 -> $
    .set 1 0x25 // 5 -> %
    .set 1 0x5E // 6 -> ^
    .set 1 0x26 // 7 -> &
    .set 1 0x2A // 8 -> *
    .set 1 0x28 // 9 -> (

:baseExtraSymbolLookup
    .set 1 0x2D // -
    .set 1 0x3D // =
    .set 1 0x5B // [
    .set 1 0x5D // ]
    .set 1 0x5C // \
    .set 1 0x3B // ;
    .set 1 0x27 // '
    .set 1 0x2C // ,
    .set 1 0x2E // .
    .set 1 0x2F // /
    .set 1 0x60 // `

:shiftedExtraSymbolLookup
    .set 1 0x5F // _
    .set 1 0x2B // +
    .set 1 0x7B // {
    .set 1 0x7D // }
    .set 1 0x7C // |
    .set 1 0x3A // :
    .set 1 0x22 // "
    .set 1 0x3C // <
    .set 1 0x3E // >
    .set 1 0x3F // ?
    .set 1 0x7E // ~
